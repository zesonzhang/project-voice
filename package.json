{
  "name": "project-voice",
  "version": "0.0.1",
  "description": "Communication support tool powered by generative AI",
  "scripts": {
    "dev": "concurrently \"npm:watch\" \"npm:serve\"",
    "dev:m0": "npm run build:m0 && concurrently \"npm:watch\" \"npm:serve:m0\"",
    "serve": "uv run main.py",
    "serve:m0": "ENABLE_M0_HARNESS=1 uv run main.py",
    "lint": "concurrently \"npm:lint:*\"",
    "lint:js": "tsc --noEmit && gts lint \"src/**/*.ts\" \"tools/m0-harness/**/*.ts\"",
    "lint:py": "uv run yapf --diff *.py tools/*.py tests/*.py",
    "clean": "gts clean",
    "build": "npm run localize:build && npm run verify:m1-prompts && esbuild src/index.ts --bundle --minify --loader:.jinja2=text --outfile=static/index.js && uv pip compile pyproject.toml -o requirements.txt",
    "build:m0": "node tools/build-m0.mjs",
    "build:storybook": "storybook build",
    "localize:extract": "lit-localize extract",
    "localize:build": "lit-localize build",
    "watch": "npm run localize:build && esbuild src/index.ts --bundle --watch --loader:.jinja2=text --define:process.env.NODE_ENV=\\\"development\\\" --outfile=static/index.js",
    "fix": "gts fix \"src/**/*.ts\" \"tools/m0-harness/**/*.ts\" && uv run yapf -i *.py tools/*.py tests/*.py",
    "pretest": "esbuild src/tests/test_index.ts --bundle --loader:.jinja2=text --outfile=spec/test_bundle.js",
    "test:js": "jasmine-browser-runner runSpecs",
    "test:m1-prompts": "npm run verify:m1-prompts",
    "test:m0-verifier": "node tools/test-m0-result-verifier.mjs",
    "test:on-device-boundary": "node tools/test-on-device-boundary.mjs",
    "verify:m1-prompts": "node tools/verify-m1-prompt-parity.mjs",
    "verify:gcs": "uv run python tools/verify_gcs_distribution.py --live",
    "verify:gcs:policy": "uv run python tools/verify_gcs_distribution.py",
    "test:py": "uv run pytest",
    "test": "concurrently \"npm:test:*\"",
    "deploy": "npm run build && gcloud app deploy app.yaml --no-promote",
    "postinstall": "uv sync",
    "storybook": "storybook dev -p 6006",
    "verify:m0": "node tools/verify-m0-results.mjs"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.0",
    "@storybook/addon-docs": "^9.1.5",
    "@storybook/web-components": "^9.1.5",
    "@storybook/web-components-vite": "^9.1.5",
    "@types/dom-speech-recognition": "^0.0.6",
    "@types/jasmine": "^5.1.9",
    "@types/node": "^24.3.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^9.1.5",
    "gts": "^6.0.2",
    "http-server": "^14.1.1",
    "jasmine-browser-runner": "^3.0.0",
    "jasmine-core": "^5.10.0",
    "node-localstorage": "^3.0.5",
    "storybook": "^9.1.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@litert-lm/core": "0.15.0",
    "@lit-labs/signals": "^0.1.3",
    "@lit/context": "^1.1.6",
    "@lit/localize": "^0.12.1",
    "@material/web": "^2.4.0",
    "diff-match-patch": "^1.0.5",
    "lit": "^3.3.1",
    "signal-polyfill": "^0.2.2",
    "simhash-js": "github:beketa/simhash-js"
  }
}
